# Rclone 集成镜像：OpenList + rclone rcd 同容器（照 aria2 集成镜像的搞法）。
#
# 重要：base 镜像（openlistteam/openlist-base-image）只含运行时依赖和 runsv，
# 不含 openlist 二进制/entrypoint/openlist 用户——那些是 Dockerfile/Dockerfile.ci
# 叠加上去的（审查发现）。所以本文件必须自己构建 openlist 并 COPY，缺了就是死容器。
#
# 构建示例（在仓库根目录）：
#   docker build -f Dockerfile.rclone -t openlist-rclone .
#
# 运行示例（宿主机 127.0.0.1 端口；内存限制在编排层，见 docker-compose.rclone.yml）：
#   docker run -d \
#     -p 127.0.0.1:5244:5244 \
#     -e RUN_RCLONE=true \
#     -v /宿主路径/openlist-data:/opt/openlist/data \
#     -v /宿主路径/rclone:/config/rclone \
#     --memory 400m openlist-rclone
#
# OpenList 挂载 Rclone 存储时的配置：
#   endpoint = http://127.0.0.1:5572 （容器内回环，rcd 不对宿主暴露端口）
#   rc_user / rc_password = 与 RCLONE_RC_USER / RCLONE_RC_PASS 一致
#
# 内存限制说明：镜像层面无法限制内存（cgroup/编排层职责）。若要 openlist 与
# rcd 分别限制，需拆双容器共享 network。

ARG BASE_IMAGE_TAG=base
FROM alpine:edge AS go-builder
LABEL stage=go-builder
RUN apk add --no-cache bash curl jq gcc git go musl-dev
WORKDIR /app/
COPY go.mod go.sum ./
RUN go mod download
COPY ./ ./
# build.sh release 依赖 git tag（git describe / git tag -d beta）：镜像构建环境通常
# 无 tag（浅克隆），用 dev 变体（version=dev、前端 rolling）——这是 Docker 构建的
# 常规路径，不影响功能。CI 实测 release 变体报 'tag beta not found' + 404。
RUN bash build.sh dev docker

FROM alpine:edge AS rclone-fetcher
# ARG 必须在 FROM 之后重新声明才在本阶段可见（Docker 作用域规则；漏了会得到空 URL，
# curl 报 'blank argument'——CI 实测抓到）
ARG RCLONE_DOWNLOAD_URL=https://github.com/yukaidi1220/rclone/releases/download/v1.76.0-cdn.23/rclone-cdn-linux-amd64
RUN apk add --no-cache curl ca-certificates tar unzip
# fork release 的 linux 资产是裸二进制（无扩展名）；也兼容 zip/tar 形态
RUN curl -sSL --retry 3 --fail -o /tmp/dl "$RCLONE_DOWNLOAD_URL" \
 && case "$RCLONE_DOWNLOAD_URL" in \
      *.zip)      unzip -o /tmp/dl -d /tmp/rl ;; \
      *.tar.gz|*.tgz)  tar -xzf /tmp/dl -C /tmp/rl ;; \
      *.tar.bz2)  tar -xjf /tmp/dl -C /tmp/rl ;; \
      *)          mkdir -p /tmp/rl && cp /tmp/dl /tmp/rl/rclone ;; \
    esac \
 && find /tmp/rl -name rclone -type f -exec mv {} /tmp/rclone \; \
 && chmod +x /tmp/rclone && /tmp/rclone version | head -n 1

FROM ghcr.io/openlistteam/openlist-base-image:${BASE_IMAGE_TAG}
LABEL MAINTAINER="OpenList"
ARG USER=openlist
ARG UID=1001
ARG GID=1001

WORKDIR /opt/openlist/

# base 镜像可能已自带 openlist 用户/组（CI 实测 addgroup 报 already exists），幂等写法
RUN (getent group ${USER} >/dev/null 2>&1 || addgroup -g ${GID} ${USER}) && \
    (getent passwd ${USER} >/dev/null 2>&1 || adduser -D -G ${USER} ${USER}) && \
    mkdir -p /opt/openlist/data /config/rclone /opt/rclone &&     chown -R ${USER}:${USER} /opt/openlist/data /opt/rclone /config/rclone

COPY --from=go-builder --chmod=755 --chown=${UID}:${GID} /app/bin/openlist ./
COPY --chmod=755 --chown=${UID}:${GID} entrypoint.sh /entrypoint.sh
COPY --from=rclone-fetcher --chmod=755 --chown=${UID}:${GID} /tmp/rclone /opt/rclone/rclone
COPY --chmod=755 docker/rclone/run.rclone /opt/service/stop/rclone/run
COPY --chmod=755 docker/rclone/finish.rclone /opt/service/stop/rclone/finish

# 骨架 rclone.conf：凭据不进镜像，运行时用 volume 覆盖（/config/rclone）
RUN printf '[cloudreve]\ntype = cloudreve\nurl =\n' > /config/rclone/rclone.conf \
 && chown -R ${UID}:${GID} /config/rclone

USER ${USER}
RUN /entrypoint.sh version && /opt/rclone/rclone version | head -n 1

# aria2 环境变量原样保留（RUN_ARIA2=false 时 entrypoint 不会启用它）
ENV UMASK=022 \
    RUN_ARIA2=false \
    RUN_RCLONE=true \
    RCLONE_RC_ADDR=127.0.0.1:5572 \
    RCLONE_RC_USER=probe \
    RCLONE_RC_PASS=probe123

VOLUME /opt/openlist/data/
EXPOSE 5244 5245
CMD [ "/entrypoint.sh" ]
